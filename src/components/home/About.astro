---
import { Image } from 'astro:assets';
// TODO: use a different photo from the hero, ideally one behind the kit.
import simon from '../../assets/simon.jpg';
---

<section id="about" class="about-section">
  <div class="container about">
    <Image
      src={simon}
      alt="Simon Richardson"
      width={360}
      height={360}
      format="webp"
      quality={75}
      class="about__photo"
    />
    <div>
      <p class="section-label">About me</p>
      <h2 class="m-heading">A real person, just up the road.</h2>
      <p>
        I'm Simon. I live in Hitchin with my two kids, and I build websites for local businesses,
        trades, bands and clubs.
      </p>
      <p>
        I have a day job in enterprise IT, so keeping things running reliably is what I do all week.
        At weekends you'll usually find me behind a drum kit at a gig.
      </p>
      <p>
        When you work with me, you deal with me. Message me and you'll hear back the same day. Same
        person from the first chat to the small change you need two years later.
      </p>
      <p class="about__now"><span class="pulse-dot about__dot" aria-hidden="true"></span><span data-now></span></p>
    </div>
  </div>
</section>

<script>
  const now = document.querySelector<HTMLElement>('[data-now]')!;
  const clock = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    weekday: 'long',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  });

  const whatImDoing = (day: string, hour: number, minute: number) => {
    const weekend = day === 'Saturday' || day === 'Sunday';
    if (hour >= 23 || hour < 7) return "so I'm asleep. Message me anyway, I'll see it first thing.";
    if ((day === 'Friday' || day === 'Saturday') && hour >= 19) return "so I'm probably behind a drum kit.";
    if (day === 'Sunday' && hour >= 18) return "so I'm probably recovering from the weekend.";
    if (weekend) return "so I'm probably out with the kids.";
    if (hour < 9) return "so I'm getting the kids out of the door.";
    if (hour < 17 || (hour === 17 && minute < 30)) return "so I'm working, but I'll reply today.";
    return "so I'm probably building someone's website.";
  };

  const tick = () => {
    const part = Object.fromEntries(clock.formatToParts(new Date()).map((p) => [p.type, p.value]));
    now.textContent = `It's ${part.weekday} ${part.hour}:${part.minute}:${part.second} in Hitchin, ${whatImDoing(part.weekday, +part.hour, +part.minute)}`;
  };
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .about__now {
    min-height: 1.7em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .about__dot { display: inline-block; margin-right: 0.6em; vertical-align: middle; }

  @media (max-width: 640px) {
    .about__now { min-height: 3.4em; }
  }

  .about-section { background: var(--bg-subtle); }

  .about { display: grid; gap: 2rem; }

  @media (min-width: 760px) {
    .about { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 4rem; align-items: center; }
  }

  .about :global(.about__photo) {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  p:not(.section-label) { color: var(--text-muted); margin-top: 1rem; max-width: 58ch; }

  @media (max-width: 640px) {
    .about :global(.about__photo) { margin-inline: auto; }
  }
</style>
