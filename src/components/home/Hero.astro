---
import { Image } from 'astro:assets';
import CtaPair from '../CtaPair.astro';
import simon from '../../assets/simon.jpg';
import { site, serviceAreaText } from '../../config/site';
---

<section class="hero">
  <div class="container hero__inner">
    <div>
      <p class="hero__where">Websites from {site.location.town}, for {serviceAreaText}</p>
      <h1 class="hero__title">Your website should be <em>bringing you work.</em></h1>
      <p class="hero__sub">
        If it's embarrassing or you don't have one, I'll fix that, and then I'll look after it so you
        never have to think about it.
      </p>
      <CtaPair />
      <p class="hero__live" aria-hidden="true">
        <span>You've been here <strong data-live-time>0:00</strong>.</span>
        <span data-live-load hidden>This page loaded in <strong data-live-speed></strong> on your device.</span>
      </p>
      <p class="hero__quip h-note" aria-hidden="true" data-live-quip></p>
    </div>
    <figure class="hero__photo">
      <Image
        src={simon}
        alt="Simon Richardson in a black T-shirt, at his desk"
        width={560}
        height={654}
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="h-note">Hello, I'm Simon</figcaption>
    </figure>
  </div>
</section>

<script>
  const time = document.querySelector<HTMLElement>('[data-live-time]')!;
  const quip = document.querySelector<HTMLElement>('[data-live-quip]')!;
  const load = document.querySelector<HTMLElement>('[data-live-load]')!;
  const speed = document.querySelector<HTMLElement>('[data-live-speed]')!;

  const quips: Record<number, string> = {
    15: 'Still here? Good sign.',
    30: "Half a minute. That's a website doing its job.",
    60: 'A whole minute. Imagine this was your site.',
    120: 'Two minutes. We should probably talk.',
    300: 'Five minutes. Stick the kettle on and message me.',
    600: "Ten minutes. At this point we're friends.",
  };

  let seconds = 0;
  setInterval(() => {
    if (document.hidden) return;
    seconds += 1;
    time.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
    if (quips[seconds]) quip.textContent = quips[seconds];
  }, 1000);

  // A real measurement from their own browser. Stays quiet if a bad connection made it slow.
  const showLoadTime = () => {
    const [nav] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
    if (!nav || nav.loadEventEnd <= 0 || nav.loadEventEnd >= 3000) return;
    speed.textContent = `${(nav.loadEventEnd / 1000).toFixed(2)}s`;
    load.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(showLoadTime);
  else addEventListener('load', () => setTimeout(showLoadTime));
</script>

<style>
  .hero__live {
    min-height: 1.7em;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero__live strong { color: var(--text); }

  /* Space is held for these lines so nothing jumps when they fill in. */
  .hero__quip {
    min-height: 1.6em;
    margin-top: 0.25rem;
    font-size: 1.5rem;
    color: var(--accent-text);
  }

  @media (max-width: 640px) {
    .hero__live { min-height: 3.4em; }
  }

  .hero { padding-block: clamp(2.5rem, 7vw, 5.5rem); }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .hero__inner { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4rem; }
  }

  .hero__where {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.03;
    font-variation-settings: 'opsz' 144, 'SOFT' 40;
    text-wrap: balance;
  }

  .hero__title em { color: var(--accent-text); }

  @media (max-width: 640px) {
    .hero__sub { margin-inline: auto; }
  }

  .hero__sub {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 44ch;
    margin-block: 1.25rem 2rem;
    line-height: 1.55;
  }

  .hero__photo {
    position: relative;
    /* A definite width, so the frame can't resize itself when the image arrives. */
    width: min(100%, 340px);
    justify-self: center;
    transform: rotate(1.5deg);
  }

  .hero__photo img {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    background: var(--bg-subtle);
    border-radius: var(--radius-lg);
    border: 6px solid var(--bg-surface);
    box-shadow: var(--shadow-card-hover);
  }

  .hero__photo figcaption {
    position: absolute;
    left: -0.75rem;
    bottom: -0.9rem;
    background: var(--bg-surface);
    color: var(--accent-text);
    padding: 0.2em 0.7em;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
    transform: rotate(-4deg);
    font-size: 1.5rem;
  }
</style>
