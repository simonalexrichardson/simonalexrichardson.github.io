---
// Drop a square photo at /public/images/simon.jpg (square crop, 600x600+).
// If the file doesn't exist, the section falls back to a styled placeholder
// so the page doesn't break — but the section reads better with a real photo.
---

<section id="about" class="container" aria-labelledby="about-heading">
  <h2 id="about-heading" class="sr-only">About Simon</h2>
  <div class="about">
    <div class="about__photo-wrap">
      <img
        src="/images/simon.jpg"
        alt="Simon Richardson"
        class="about__photo"
        width="200"
        height="200"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'; this.parentElement.classList.add('about__photo-wrap--placeholder');"
      />
    </div>

    <div class="about__body">
      <p class="section-label" aria-hidden="true">About</p>
      <p class="about__credibility">
        <strong>Day job:</strong> Head of Infrastructure &amp; Platform at Abcam,
        leading a global team across cloud and platform.
        <span class="about__credibility-sep" aria-hidden="true">·</span>
        <strong>Freelance:</strong> I build the things I wish more sites did.
      </p>
      <p class="about__text">
        I'm Simon, a UK-based freelance web designer and developer,
        working with clients here and remote. I care about shipping
        things that actually do the job, not just look the part. Most
        of my work sits between marketing sites and custom applications,
        with a growing share of AI features.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (max-width: 540px) {
    .about {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      justify-items: start;
    }
  }

  .about__photo-wrap {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .about__photo-wrap--placeholder {
    background:
      linear-gradient(135deg, var(--bg-subtle), var(--bg-surface));
    position: relative;
  }

  .about__photo-wrap--placeholder::after {
    content: 'sar';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-faint);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .about__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__body {
    max-width: 56ch;
  }

  .about__credibility {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
    padding: 0.875rem 1rem;
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 1.25rem;
  }

  .about__credibility strong {
    color: var(--text);
    font-weight: 700;
  }

  .about__credibility-sep {
    margin: 0 0.4em;
    color: var(--text-faint);
  }

  .about__text {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.75;
  }
</style>
