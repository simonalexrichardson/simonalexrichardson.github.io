---
import { getCollection } from 'astro:content';

const posts = (await getCollection(
  'writing',
  ({ data }) => import.meta.env.PROD ? !data.draft : true,
))
  .sort((a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt))
  .slice(0, 3);

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{posts.length > 0 && (
  <section id="recent-writing" class="container recent-writing" aria-labelledby="recent-writing-heading">
    <div class="recent-writing__head">
      <p class="section-label">Recent writing</p>
      <h2 id="recent-writing-heading" class="recent-writing__title">Notes from the workbench</h2>
      <a href="/writing" class="recent-writing__all">All writing <span aria-hidden="true">→</span></a>
    </div>

    <ul class="recent-writing__list" role="list">
      {posts.map((post) => (
        <li class="recent-writing__item">
          <a href={`/writing/${post.id}`} class="recent-writing__link">
            <time class="recent-writing__date" datetime={new Date(post.data.publishedAt).toISOString()}>
              {fmtDate(post.data.publishedAt)}
            </time>
            <h3 class="recent-writing__post-title">{post.data.title}</h3>
            <p class="recent-writing__summary">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .recent-writing__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .recent-writing__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    flex: 1;
    min-width: 0;
  }

  .recent-writing__all {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--transition);
  }

  .recent-writing__all:hover {
    color: var(--accent-hover);
  }

  .recent-writing__all span {
    display: inline-block;
    transition: transform var(--transition);
  }

  .recent-writing__all:hover span {
    transform: translateX(3px);
  }

  .recent-writing__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 880px) {
    .recent-writing__list { grid-template-columns: 1fr; }
  }

  .recent-writing__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem 1.25rem 1.375rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .recent-writing__link:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .recent-writing__date {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .recent-writing__post-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text);
    transition: color var(--transition);
  }

  .recent-writing__link:hover .recent-writing__post-title {
    color: var(--accent);
  }

  .recent-writing__summary {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
