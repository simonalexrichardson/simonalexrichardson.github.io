---
import { getCollection } from 'astro:content';
import { projects, concepts } from '../data/projects.ts';

const [featured, ...rest] = projects;

// Only treat caseStudy as live if a non-draft entry exists (drafts shown in dev).
const liveCaseStudies = new Set(
  (await getCollection(
    'case-studies',
    ({ data }) => import.meta.env.PROD ? !data.draft : true,
  )).map((cs) => `/case-studies/${cs.id}`),
);

const featuredCaseStudy = featured.caseStudy && liveCaseStudies.has(featured.caseStudy)
  ? featured.caseStudy
  : null;
---

<section id="work" class="container">
  <p class="section-label">Things I've built</p>

  <!-- Featured card -->
  <a
    href={featuredCaseStudy ?? featured.url}
    class="work-featured"
    target={featuredCaseStudy ? undefined : '_blank'}
    rel={featuredCaseStudy ? undefined : 'noopener noreferrer'}
    aria-label={featuredCaseStudy ? `Read the ${featured.name} case study` : `Visit ${featured.name} (opens in new tab)`}
  >
    <div class="work-featured__image-wrap">
      <img
        src={featured.image}
        alt={featured.imageAlt}
        class="work-featured__image"
        width="960"
        height="560"
        loading="eager"
        decoding="async"
      />
      <div class="work-featured__overlay" aria-hidden="true">
        <span class="work-featured__visit">{featuredCaseStudy ? 'Read case study →' : 'Visit site ↗'}</span>
      </div>
    </div>
    <div class="work-featured__body">
      <div class="work-featured__meta">
        <span class="tag">{featured.tag}</span>
        <span class="work-featured__url">{new URL(featured.url).hostname}</span>
      </div>
      <h2 class="work-featured__name">{featured.name}</h2>
      <p class="work-featured__desc">{featured.description}</p>
    </div>
  </a>

  <!-- Remaining cards -->
  <ul class="work-grid" role="list">
    {
      rest.map((project) => (
        <li class="work-card">
          <a
            href={project.url}
            class="work-card__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${project.name} (opens in new tab)`}
          >
            <div class="work-card__image-wrap">
              <img
                src={project.image}
                alt={project.imageAlt}
                class="work-card__image"
                width="600"
                height="375"
                loading="lazy"
                decoding="async"
              />
              <div class="work-card__overlay" aria-hidden="true">
                <span>Visit site ↗</span>
              </div>
            </div>
            <div class="work-card__body">
              <div class="work-card__meta">
                <span class="tag">{project.tag}</span>
                <span class="work-card__url">{new URL(project.url).hostname}</span>
              </div>
              <h3 class="work-card__name">{project.name}</h3>
              <p class="work-card__desc">{project.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  {concepts.length > 0 && (
    <div class="work-concepts">
      <div class="work-concepts__head">
        <h2 class="work-concepts__title">Pick a style. I'll make yours.</h2>
        <p class="work-concepts__intro">What I'd build for an electrician, a plumber, a care provider...</p>
      </div>
      <ul class="concept-grid" role="list">
        {concepts.map((concept) => (
          <li class="concept-card">
            <a
              href={concept.url}
              class="concept-card__image-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View the ${concept.name} concept (opens in new tab)`}
            >
              <div class="concept-card__image-wrap">
                <img
                  src={concept.image}
                  alt={concept.imageAlt}
                  class="concept-card__image"
                  width="480"
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
                <div class="concept-card__overlay" aria-hidden="true">
                  <span>View concept ↗</span>
                </div>
              </div>
            </a>
            <div class="concept-card__body">
              <div class="concept-card__meta">
                <span class="tag tag--muted">{concept.tag}</span>
              </div>
              <h3 class="concept-card__name">{concept.name}</h3>
              <a href="#contact" class="concept-card__cta">
                Want one like this? <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  /* ── Featured card ── */

  .work-featured {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.25rem;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition-slow),
      border-color var(--transition-slow),
      transform var(--transition-slow);
  }

  .work-featured:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .work-featured__image-wrap {
    position: relative;
    aspect-ratio: 16 / 8;
    background: var(--bg-subtle);
    overflow: hidden;
  }

  .work-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .work-featured:hover .work-featured__image {
    transform: scale(1.02);
  }

  .work-featured__overlay {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: rgba(24, 23, 15, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .work-featured:hover .work-featured__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .work-featured__visit {
    letter-spacing: -0.01em;
  }

  .work-featured__body {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .work-featured__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .work-featured__url,
  .work-card__url {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .work-featured__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .work-featured__desc {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 60ch;
  }

  /* ── Grid cards ── */

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    list-style: none;
  }

  @media (max-width: 580px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Orphan card (odd number): cap at half width */
  .work-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: calc(50% - 0.625rem);
  }

  @media (max-width: 580px) {
    .work-card:last-child:nth-child(odd) {
      grid-column: auto;
      max-width: none;
    }
  }

  .work-card__link {
    display: block;
    height: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition-slow),
      border-color var(--transition-slow),
      transform var(--transition-slow);
  }

  .work-card__link:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-strong);
    transform: translateY(-3px);
    outline: none;
  }

  .work-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-subtle);
    overflow: hidden;
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .work-card__link:hover .work-card__image {
    transform: scale(1.03);
  }

  .work-card__overlay {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    background: rgba(24, 23, 15, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.4em 0.75em;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .work-card__link:hover .work-card__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .work-card__body {
    padding: 1.125rem 1.25rem 1.375rem;
  }

  .work-card__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .work-card__name {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .work-card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* ── Concepts (speculative builds) ── */

  .work-concepts {
    margin-top: 3rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .work-concepts__head {
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  .work-concepts__title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.4rem;
  }

  .work-concepts__intro {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    list-style: none;
  }

  @media (max-width: 880px) {
    .concept-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .concept-grid {
      grid-template-columns: 1fr;
    }
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition-slow),
      border-color var(--transition-slow),
      transform var(--transition-slow);
  }

  .concept-card:hover,
  .concept-card:focus-within {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .concept-card__image-link {
    display: block;
    text-decoration: none;
  }

  .concept-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-subtle);
    overflow: hidden;
  }

  .concept-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .concept-card:hover .concept-card__image {
    transform: scale(1.03);
  }

  .concept-card__overlay {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: inline-flex;
    align-items: center;
    background: rgba(24, 23, 15, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.35em 0.7em;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .concept-card__image-link:hover .concept-card__overlay,
  .concept-card__image-link:focus-visible .concept-card__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .concept-card__body {
    padding: 0.875rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .concept-card__meta {
    margin: 0;
  }

  .concept-card__name {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .concept-card__cta {
    margin-top: auto;
    padding-top: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition);
  }

  .concept-card__cta span {
    transition: transform var(--transition);
  }

  .concept-card__cta:hover span,
  .concept-card__cta:focus-visible span {
    transform: translateX(3px);
  }
</style>
