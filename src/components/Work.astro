---
interface Project {
  name: string;
  url: string;
  description: string;
  tag: string;
  image: string;
  imageAlt: string;
}

const projects: Project[] = [
  {
    name: 'Quietloon',
    url: 'https://quietloon.com',
    description: 'AI-powered email workflows for families',
    tag: 'Web app',
    image: '/images/quietloon.svg',
    imageAlt: 'Screenshot of the Quietloon web application',
  },
  {
    name: 'Reaper Drones',
    url: 'https://reaperdrones.com',
    description: 'Professional drone survey and inspection services', // TODO: replace with real tagline
    tag: 'Marketing site',
    image: '/images/reaperdrones.svg',
    imageAlt: 'Screenshot of the Reaper Drones website',
  },
  {
    name: 'Altitude Drone Surveying',
    url: 'https://example.com', // TODO: replace with live URL
    description: 'Professional drone survey and inspection services', // TODO: replace with real tagline
    tag: 'Marketing site',
    image: '/images/altitude.svg',
    imageAlt: 'Screenshot of the Altitude Drone Surveying website',
  },
  {
    name: 'The Non-Starters',
    url: 'https://example.com', // TODO: replace with live URL
    description: 'The band with no plans and all the songs', // TODO: replace with real tagline
    tag: 'Marketing site',
    image: '/images/nonstarters.svg',
    imageAlt: 'Screenshot of The Non-Starters website',
  },
  {
    name: 'Shabby Roads',
    url: 'https://example.com', // TODO: replace with live URL
    description: 'Vintage furniture and curiosities, online', // TODO: replace with real tagline
    tag: 'Marketing site',
    image: '/images/shabbyroads.svg',
    imageAlt: 'Screenshot of the Shabby Roads website',
  },
];
---

<section id="work" class="container">
  <h2 class="section-heading">Things I've built</h2>
  <p class="section-subheading">A few recent projects.</p>

  <ul class="work-grid" role="list">
    {
      projects.map((project) => (
        <li class="work-card">
          <a
            href={project.url}
            class="work-card__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${project.name} (opens in new tab)`}
          >
            <div class="work-card__image-wrap">
              <img
                src={project.image}
                alt={project.imageAlt}
                class="work-card__image"
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="work-card__body">
              <span class="work-card__tag">{project.tag}</span>
              <h3 class="work-card__name">{project.name}</h3>
              <p class="work-card__desc">{project.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    list-style: none;
  }

  /* Last card spans full width if it's an orphan (odd total) */
  .work-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: calc(50% - 0.625rem);
  }

  @media (max-width: 600px) {
    .work-grid {
      grid-template-columns: 1fr;
    }

    .work-card:last-child:nth-child(odd) {
      grid-column: auto;
      max-width: none;
    }
  }

  .work-card__link {
    display: block;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
    height: 100%;
  }

  .work-card__link:hover,
  .work-card__link:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--accent);
    outline: none;
  }

  .work-card__image-wrap {
    aspect-ratio: 16 / 10;
    background-color: var(--border);
    overflow: hidden;
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__body {
    padding: 1.25rem 1.375rem 1.375rem;
  }

  .work-card__tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .work-card__name {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.4rem;
  }

  .work-card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
