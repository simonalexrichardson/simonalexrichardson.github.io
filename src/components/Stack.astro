---
import {
  siAstro,
  siNextdotjs,
  siReact,
  siTypescript,
  siNodedotjs,
  siTailwindcss,
  siAnthropic,
  siPostgresql,
  siSupabase,
  siStripe,
  siVercel,
  siGithub,
} from 'simple-icons';

// Flag near-black brand colours so we can swap them for a visible colour in dark mode.
function isDark(hex: string) {
  const r = parseInt(hex.slice(0, 2), 16) / 255;
  const g = parseInt(hex.slice(2, 4), 16) / 255;
  const b = parseInt(hex.slice(4, 6), 16) / 255;
  return 0.299 * r + 0.587 * g + 0.114 * b < 0.2;
}

const tools = [
  siAstro,
  siNextdotjs,
  siReact,
  siTypescript,
  siNodedotjs,
  siTailwindcss,
  siAnthropic,
  siPostgresql,
  siSupabase,
  siStripe,
  siVercel,
  siGithub,
].map((t) => ({ ...t, dark: isDark(t.hex) }));
---

<section id="stack" class="container">
  <p class="section-label">Tools of the trade</p>

  <ul class="stack-list" role="list">
    {tools.map((tool) => (
      <li class="stack-item">
        <span
          class:list={['stack-item__icon', { 'stack-item__icon--dark': tool.dark }]}
          style={`--brand: #${tool.hex}`}
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
            <path d={tool.path} />
          </svg>
        </span>
        <span class="stack-item__label">{tool.title}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .stack-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem 1.25rem;
  }

  @media (max-width: 880px) {
    .stack-list { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 540px) {
    .stack-list { grid-template-columns: repeat(3, 1fr); }
  }

  .stack-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 1.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .stack-item:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .stack-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--brand);
    filter: saturate(0.9);
  }

  @media (prefers-color-scheme: dark) {
    .stack-item__icon { filter: saturate(0.85) brightness(1.1); }
    /* Near-black brand colours disappear on dark backgrounds — swap for foreground */
    .stack-item__icon--dark { color: var(--text); filter: none; }
  }

  .stack-item__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .stack-item__label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }
</style>
