---
---

<header class="hero">
  <div class="container">
    <p class="eyebrow hero__availability">
      <span class="pulse-dot" aria-hidden="true"></span>
      Available for new projects
    </p>

    <h1 class="hero__heading">
      Hi, I'm Simon.
    </h1>

    <p class="hero__bio">
      I build websites and web apps for people who want them to actually
      work: marketing sites, custom applications, AI features. I
      co-founded <a href="https://www.quietloon.com" target="_blank" rel="noopener noreferrer" class="hero__bio-link">Quiet Loon</a>, now live, so I know the difference
      between something that demos well and something that ships.
    </p>

    <div class="hero__actions">
      <a href="#contact" class="hero__btn hero__btn--primary">
        Get in touch
        <span aria-hidden="true">→</span>
      </a>
      <a href="#work" class="hero__btn hero__btn--ghost">
        See my work
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero__availability {
    margin-bottom: 1.75rem;
  }

  .hero__heading {
    font-size: var(--text-hero);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }

  .hero__bio {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .hero__bio-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .hero__bio-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.7em 1.5em;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .hero__btn:active { transform: scale(0.97); }

  .hero__btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .hero__btn--primary:hover {
    background: var(--accent-hover);
  }

  .hero__btn--ghost {
    color: var(--text-muted);
    border: 1.5px solid var(--border-strong);
  }

  .hero__btn--ghost:hover {
    border-color: var(--text);
    color: var(--text);
  }
</style>
