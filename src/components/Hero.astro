---
---

<header class="hero">
  <div class="container">
    <p class="hero__availability">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span class="hero__availability-text">
        Booking <em>new</em> projects
      </span>
      <span class="hero__availability-wave" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 13c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/>
        </svg>
      </span>
    </p>

    <h1 class="hero__heading">
      Hi, I'm
      <span class="hero__name">
        Simon
        <svg class="hero__underline" viewBox="0 0 220 18" aria-hidden="true" preserveAspectRatio="none">
          <path d="M3 12 Q 30 4, 60 11 T 120 10 T 180 11 T 215 9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </span>.
    </h1>

    <p class="hero__bio">
      I build websites and web apps for people who want them to actually
      work: marketing sites, custom applications, AI features. I
      co-founded <a href="https://www.quietloon.com" target="_blank" rel="noopener noreferrer" class="hero__bio-link">Quiet Loon</a>, now live, so I know the difference
      between something that demos well and something that ships.
    </p>

    <div class="hero__actions">
      <a href="#contact" class="hero__btn hero__btn--primary">
        Get in touch
        <span aria-hidden="true">→</span>
      </a>
      <a href="#work" class="hero__btn hero__btn--ghost">
        See my work
        <span aria-hidden="true">↓</span>
      </a>
      <span class="hero__quip" aria-hidden="true">
        <span class="hero__quip-text">start here</span>
        <svg class="hero__quip-arrow" viewBox="0 0 80 50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Sweep from below 'start here' down-left to the primary CTA -->
          <path d="M68 8 Q 55 38 14 30"/>
          <!-- Arrowhead pointing up-left at the curve's endpoint -->
          <path d="M22 22 L 14 30 L 22 36"/>
        </svg>
      </span>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    line-height: 1;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 0.45em 0.85em 0.55em;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    margin-bottom: 1.5rem;
    transform: rotate(-1deg);
    transition: transform var(--transition), background var(--transition);
  }

  .hero__availability:hover {
    transform: rotate(0deg);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hero__availability .pulse-dot {
    width: 9px;
    height: 9px;
  }

  .hero__availability em {
    font-style: italic;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .hero__availability-wave {
    display: inline-flex;
    width: 22px;
    height: 22px;
    margin-left: -0.1rem;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-hero);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    font-variation-settings: "opsz" 144, "SOFT" 50, "WONK" 1;
  }

  .hero__name {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--accent);
  }

  .hero__underline {
    position: absolute;
    left: 0;
    right: -0.05em;
    bottom: -0.18em;
    width: 100%;
    height: 0.32em;
    color: var(--accent);
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: hero-underline 1.4s 0.4s cubic-bezier(.65,0,.35,1) forwards;
  }

  @keyframes hero-underline {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__underline {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  .hero__bio {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .hero__bio-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .hero__bio-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    position: relative;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.75em 1.6em;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .hero__btn:active { transform: scale(0.97); }

  .hero__btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .hero__btn--primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .hero__btn--ghost {
    color: var(--text-muted);
    border: 1.5px solid var(--border-strong);
  }

  .hero__btn--ghost:hover {
    border-color: var(--text);
    color: var(--text);
  }

  /* Hand-written 'start here' annotation pointing at the primary CTA */
  .hero__quip {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1;
    transform: translateY(0.35rem) rotate(-3deg);
    margin-left: -0.25rem;
    pointer-events: none;
  }

  .hero__quip-arrow {
    width: 58px;
    height: 38px;
    transform: translateY(0.4rem);
  }

  @media (max-width: 560px) {
    .hero__quip { display: none; }
  }
</style>
