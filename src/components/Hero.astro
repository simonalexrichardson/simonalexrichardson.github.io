---
import { projects } from '../data/projects.ts';
---

<header class="hero">
  <div class="container hero__container">

    <div class="hero__left">
      <p class="eyebrow hero__availability">
        <span class="pulse-dot" aria-hidden="true"></span>
        Available for new projects
      </p>

      <h1 class="hero__heading">
        Hi, I'm Simon.
      </h1>

      <!--
        Option B: "Websites and web apps, built properly. Simple landing pages
        to full applications with AI features and custom integrations. I've built
        for my own projects too, so I understand what shipping under real
        constraints looks like."

        Option C: "Most of what I build falls somewhere between 'we just need a
        site' and 'we need something custom.' I work across that whole range —
        and because I build my own products too, I understand the difference
        between building something and actually using it."

        Chosen — Option A:
      -->
      <p class="hero__bio">
        I build websites and web apps for people who want them to actually
        work — marketing sites, custom applications, AI features. My own
        founder product, <a href="https://quietloon.com" target="_blank" rel="noopener noreferrer" class="hero__bio-link">Quiet Loon</a>, is live,
        so I know the difference between something that demos well and
        something that ships.
      </p>

      <div class="hero__actions">
        <a href="#work" class="hero__btn hero__btn--primary">
          See my work
          <span aria-hidden="true">↓</span>
        </a>
        <a href="#contact" class="hero__btn hero__btn--ghost">
          Get in touch
        </a>
      </div>
    </div>

    <aside class="hero__right" aria-label="Recent projects">
      <p class="section-label">Recent work</p>
      <ul class="hero__project-list" role="list">
        {projects.map((project) => (
          <li class="hero__project-item">
            <a
              href={project.url}
              class="hero__project-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="hero__project-name">{project.name}</span>
              <span class="hero__project-tag">{project.tag}</span>
              <span class="hero__project-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

  </div>
</header>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .hero__container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* ── Left column ── */

  .hero__availability {
    margin-bottom: 1.75rem;
  }

  .hero__heading {
    font-size: var(--text-hero);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }

  .hero__bio {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 46ch;
    margin-bottom: 2.5rem;
  }

  .hero__bio-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .hero__bio-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.6em 1.4em;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .hero__btn:active { transform: scale(0.97); }

  .hero__btn--primary {
    background: var(--text);
    color: var(--bg);
  }

  .hero__btn--primary:hover {
    background: var(--accent);
  }

  .hero__btn--ghost {
    color: var(--text-muted);
    border: 1.5px solid var(--border-strong);
  }

  .hero__btn--ghost:hover {
    border-color: var(--text);
    color: var(--text);
  }

  /* ── Right column: project list ── */

  .hero__right {
    padding-top: 0.25rem;
  }

  .hero__project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .hero__project-item {
    border-top: 1px solid var(--border);
  }

  .hero__project-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .hero__project-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.875rem;
    transition: color var(--transition);
  }

  .hero__project-link:hover {
    color: var(--accent);
  }

  .hero__project-link:hover .hero__project-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .hero__project-name {
    font-size: var(--text-sm);
    font-weight: 600;
    flex: 1;
  }

  .hero__project-tag {
    font-size: var(--text-xs);
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .hero__project-arrow {
    font-size: var(--text-xs);
    color: var(--text-faint);
    flex-shrink: 0;
    transition: color var(--transition), transform var(--transition);
  }
</style>
