---
const quotes = [
  {
    body: "Simon got our site live in days, not months. He pushed back where it mattered, asked questions I hadn't thought of, and made the right calls. No hand-holding required.",
    name: 'Adam',
    org: 'Altitude Drone Surveying',
  },
  {
    body: "Half the brief was jokes, the other half was contradictions. Simon got both. The site sounds like us, not like a brochure.",
    name: 'Barry',
    org: 'The Non-Starters',
  },
  {
    body: "We needed somewhere bookers could find our setlist and listen before calling. Done in a week. Looks better than half the venues we play.",
    name: 'Simon',
    org: 'Shabby Road',
  },
];
---

<section id="testimonial" class="container" aria-labelledby="testimonial-heading">
  <h2 id="testimonial-heading" class="sr-only">Client testimonials</h2>
  <p class="testimonials__lead-in" aria-hidden="true">
    <span class="h-note">Real clients</span>
    <svg viewBox="0 0 50 60" aria-hidden="true">
      <path d="M8 6 Q 22 24 28 50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M22 44 L 28 50 L 34 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </p>
  <ul class="testimonials" role="list">
    {quotes.map((q) => (
      <li>
        <figure class="testimonial">
          <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
          <blockquote class="testimonial__quote">
            <p>{q.body}</p>
          </blockquote>
          <figcaption class="testimonial__attribution">
            <strong>{q.name}</strong>
            <span aria-hidden="true"> · </span>
            <span class="testimonial__org">{q.org}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .testimonials__lead-in {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.3rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
    transform: translateX(0.5rem) rotate(-4deg);
  }

  .testimonials__lead-in svg {
    width: 32px;
    height: 42px;
    transform: translateY(0.4rem);
  }

  .testimonials {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 880px) {
    .testimonials { grid-template-columns: 1fr; gap: 1rem; }
  }

  .testimonial {
    position: relative;
    height: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .testimonial:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .testimonial__mark {
    position: absolute;
    top: -0.1rem;
    left: 1.25rem;
    font-size: 3.5rem;
    line-height: 1;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--accent);
    opacity: 0.55;
    pointer-events: none;
  }

  .testimonial__quote {
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.55;
    color: var(--text);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .testimonial__attribution {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .testimonial__attribution strong {
    color: var(--text);
    font-weight: 700;
  }

  .testimonial__org {
    color: var(--text-faint);
  }
</style>
