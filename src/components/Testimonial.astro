---
// Single pull-quote. Add more later if you collect them — for now, one strong
// one carries more weight than three middling ones.
---

<section id="testimonial" class="container" aria-labelledby="testimonial-heading">
  <h2 id="testimonial-heading" class="sr-only">Client testimonial</h2>
  <figure class="testimonial">
    <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
    <blockquote class="testimonial__quote">
      <p>
        Simon got our site live in days, not months. He pushed back where it
        mattered, asked questions I hadn't thought of, and made the right calls.
        No hand-holding required.
      </p>
    </blockquote>
    <figcaption class="testimonial__attribution">
      <strong>Adam</strong> · Altitude Drone Surveying
    </figcaption>
  </figure>
</section>

<style>
  .testimonial {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    position: relative;
    padding-top: 1rem;
  }

  .testimonial__mark {
    position: absolute;
    top: -1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 5rem;
    line-height: 1;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--accent);
    opacity: 0.4;
    pointer-events: none;
  }

  .testimonial__quote {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 540px) {
    .testimonial__quote {
      font-size: var(--text-xl);
    }
  }

  .testimonial__attribution {
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .testimonial__attribution strong {
    color: var(--text);
    font-weight: 600;
  }
</style>
