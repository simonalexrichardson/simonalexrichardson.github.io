---
const services = [
  {
    num: '01',
    heading: 'Marketing sites',
    body: 'Landing pages and multi-page sites that load fast and read well. Built to convert, not just to look good.',
    examples: ['Astro / Next.js', 'CMS optional', 'Deployed to Vercel or Cloudflare'],
    // browser / window icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9h18"/><circle cx="6.5" cy="7" r=".6" fill="currentColor"/><circle cx="9" cy="7" r=".6" fill="currentColor"/></svg>',
  },
  {
    num: '02',
    heading: 'Web applications',
    body: 'Custom apps with forms, dashboards, payments, auth. Whatever the project needs. I build for what you actually ship, not a hypothetical.',
    examples: ['Next.js + Postgres', 'Stripe, auth, dashboards', 'Real production scale'],
    // layout / grid icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></svg>',
  },
  {
    num: '03',
    heading: 'AI features',
    body: 'Email automation, AI-powered workflows, integrations with Claude and similar APIs. I know where these tools earn their keep and where they\'re just noise.',
    examples: ['Claude API', 'Structured extraction', 'Bounded, cached, observable'],
    // sparkle icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4"/><path d="M12 17v4"/><path d="M5 12H3"/><path d="M21 12h-2"/><path d="M6.3 6.3 7.7 7.7"/><path d="M16.3 16.3l1.4 1.4"/><path d="M6.3 17.7l1.4-1.4"/><path d="M16.3 7.7l1.4-1.4"/><circle cx="12" cy="12" r="2.5"/></svg>',
  },
];
---

<section id="services" class="container">
  <p class="section-label">What I build</p>

  <p class="services__lead">
    I build for what you actually ship. Not the polished demo, not the
    hypothetical scale. The real thing. Three areas I work in most:
  </p>

  <ul class="services-grid" role="list">
    {services.map((service) => (
      <li class="service">
        <div class="service__icon" aria-hidden="true" set:html={service.icon} />
        <span class="service__num" aria-hidden="true">{service.num}</span>
        <h2 class="service__heading">{service.heading}</h2>
        <p class="service__body">{service.body}</p>
        <ul class="service__examples" role="list">
          {service.examples.map((ex) => (
            <li>{ex}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .services__lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 56ch;
    margin-bottom: 2.5rem;
  }

  .services-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 880px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem 1.5rem;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .service::before {
    /* Subtle accent strip across the top */
    content: '';
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 2px;
    background: var(--accent);
    border-radius: 0 0 2px 2px;
    opacity: 0.4;
    transition: opacity var(--transition), left var(--transition), right var(--transition);
  }

  .service:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .service:hover::before {
    opacity: 1;
    left: 0.75rem;
    right: 0.75rem;
  }

  .service__icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--accent-subtle);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .service__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .service__num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }

  .service__heading {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.625rem;
  }

  .service__body {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.125rem;
  }

  .service__examples {
    list-style: none;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .service__examples li {
    font-size: var(--text-xs);
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .service__examples li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
</style>
