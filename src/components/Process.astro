---
const steps = [
  {
    num: '01',
    heading: 'Tell me what you have in mind',
    body: 'A short message via the form below: what you\'re building, who it\'s for, any constraints. No need for a brief.',
  },
  {
    num: '02',
    heading: 'I come back with a plan and a price',
    body: 'Within a couple of days. A straight quote, an honest sense of timeline, and what I\'d push back on. No retainers, no sales calls.',
  },
  {
    num: '03',
    heading: 'We ship',
    body: 'Most projects take two to six weeks. You see progress as it lands, not at the end. If something\'s not working, we change it before it ships, not after.',
  },
];
---

<section id="process" class="container" aria-labelledby="process-heading">
  <h2 id="process-heading" class="section-label">How this works</h2>

  <ol class="process-list" role="list">
    {steps.map((step) => (
      <li class="process-step">
        <span class="process-step__num" aria-hidden="true">{step.num}</span>
        <h3 class="process-step__heading">{step.heading}</h3>
        <p class="process-step__body">{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .process-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 720px) {
    .process-list { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  .process-step {
    position: relative;
    padding-top: 1.5rem;
    border-top: 2px solid var(--accent);
  }

  .process-step__num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.875rem;
    display: block;
  }

  .process-step__heading {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.625rem;
  }

  .process-step__body {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
  }
</style>
