---
const steps = [
  {
    num: '01',
    heading: 'Tell me what you have in mind',
    body: 'A short message via the form below: what you\'re building, who it\'s for, any constraints. No need for a brief.',
    // chat / message icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12c0 4.4-4 8-9 8a9.7 9.7 0 0 1-4.2-1L3 20l1.1-4.4A8 8 0 0 1 3 12c0-4.4 4-8 9-8s9 3.6 9 8Z"/></svg>',
  },
  {
    num: '02',
    heading: 'I come back with a plan and a price',
    body: 'Within a couple of days. A straight quote, an honest sense of timeline, and what I\'d push back on. No retainers, no sales calls.',
    // clipboard / plan icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M8.5 12h7"/><path d="M8.5 15.5h5"/></svg>',
  },
  {
    num: '03',
    heading: 'We ship',
    body: 'Most projects take two to six weeks. You see progress as it lands, not at the end. If something\'s not working, we change it before it ships, not after.',
    // rocket icon
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 12.5 18.5 8a5 5 0 0 0-3.5-3.5L10.5 9"/><path d="M9 11l-4 1 .5 4 4 .5 1-4"/><path d="M5 16l-2 5 5-2"/><circle cx="15" cy="9" r="1"/></svg>',
  },
];
---

<section id="process" class="container" aria-labelledby="process-heading">
  <h2 id="process-heading" class="section-label">How this works</h2>

  <ol class="process-list" role="list">
    {steps.map((step, i) => (
      <li class="process-step">
        <div class="process-step__top">
          <div class="process-step__icon" aria-hidden="true" set:html={step.icon} />
          <span class="process-step__num" aria-hidden="true">{step.num}</span>
        </div>
        <h3 class="process-step__heading">{step.heading}</h3>
        <p class="process-step__body">{step.body}</p>
        {i < steps.length - 1 && (
          <span class="process-step__connector" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </span>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .process-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 720px) {
    .process-list { grid-template-columns: 1fr; gap: 1rem; }
  }

  .process-step {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.5rem 1.625rem;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .process-step:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .process-step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .process-step__icon {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .process-step__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .process-step__num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .process-step__heading {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.625rem;
  }

  .process-step__body {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .process-step__connector {
    position: absolute;
    top: 50%;
    right: -1.875rem;
    width: 24px;
    height: 24px;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-faint);
    background: var(--bg);
    border-radius: 50%;
    padding: 2px;
    z-index: 2;
  }

  .process-step__connector :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 720px) {
    .process-step__connector {
      top: auto;
      right: auto;
      bottom: -1.5rem;
      left: 50%;
      transform: translateX(-50%) rotate(90deg);
    }
  }
</style>
