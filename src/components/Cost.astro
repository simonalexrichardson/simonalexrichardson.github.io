---
// Rough cost estimator. Numbers are starting points, not quotes.
// Math is mirrored in the inline <script> below; keep them in sync.
// Default state (5 pages + custom design) = £500.
const BASE = 300;          // 5 pages without custom design
const BASE_PAGES = 5;
const PER_PAGE = 100;      // each page above BASE_PAGES
const CUSTOM_DESIGN = 200;
const FORMS_MAILING = 500;
const AI_FEATURES = 1500;

const defaults = {
  pages: 5,
  customDesign: true,
  formsMailing: false,
  ai: false,
};

const extraPages = Math.max(0, defaults.pages - BASE_PAGES);
const defaultEstimate =
  BASE +
  extraPages * PER_PAGE +
  (defaults.customDesign ? CUSTOM_DESIGN : 0) +
  (defaults.formsMailing ? FORMS_MAILING : 0) +
  (defaults.ai ? AI_FEATURES : 0);
---

<section id="cost" class="container" aria-labelledby="cost-heading">
  <p class="section-label">Rough cost</p>
  <h2 id="cost-heading" class="cost__heading">What might it cost?</h2>
  <p class="cost__intro">
    A bespoke 5-page site starts at £500. Drag the scope below to see how
    extras change the estimate. This is a ballpark, not a quote.
  </p>

  <form
    class="cost-form"
    aria-describedby="cost-result"
    data-base={BASE}
    data-base-pages={BASE_PAGES}
    data-per-page={PER_PAGE}
    data-custom={CUSTOM_DESIGN}
    data-forms={FORMS_MAILING}
    data-ai={AI_FEATURES}
  >
    <div class="cost-controls">
      <div class="cost-control">
        <div class="cost-control__head">
          <label for="cost-pages" class="cost-control__label">Pages</label>
          <output for="cost-pages" id="cost-pages-out" class="cost-control__value">{defaults.pages}</output>
        </div>
        <input
          type="range"
          id="cost-pages"
          name="pages"
          min="1"
          max="12"
          step="1"
          value={defaults.pages}
          class="cost-range"
        />
        <div class="cost-range__scale" aria-hidden="true">
          <span>1</span>
          <span>12</span>
        </div>
      </div>

      <fieldset class="cost-toggles">
        <legend class="sr-only">Scope</legend>

        <label class="cost-toggle">
          <input type="checkbox" name="customDesign" checked={defaults.customDesign} />
          <span class="cost-toggle__body">
            <span class="cost-toggle__name">Custom design</span>
            <span class="cost-toggle__hint">Bespoke look, hand-built, no templates</span>
          </span>
          <span class="cost-toggle__price">+ £{CUSTOM_DESIGN.toLocaleString('en-GB')}</span>
        </label>

        <label class="cost-toggle">
          <input type="checkbox" name="formsMailing" checked={defaults.formsMailing} />
          <span class="cost-toggle__body">
            <span class="cost-toggle__name">Forms &amp; mailing</span>
            <span class="cost-toggle__hint">Contact forms, newsletter signups, transactional email</span>
          </span>
          <span class="cost-toggle__price">+ £{FORMS_MAILING.toLocaleString('en-GB')}</span>
        </label>

        <label class="cost-toggle">
          <input type="checkbox" name="ai" checked={defaults.ai} />
          <span class="cost-toggle__body">
            <span class="cost-toggle__name">AI features</span>
            <span class="cost-toggle__hint">Claude integration, structured parsing, summaries</span>
          </span>
          <span class="cost-toggle__price">+ £{AI_FEATURES.toLocaleString('en-GB')}</span>
        </label>
      </fieldset>
    </div>

    <aside class="cost-result" id="cost-result" aria-live="polite">
      <p class="cost-result__label">Rough estimate</p>
      <p class="cost-result__value">
        £<span id="cost-amount">{defaultEstimate.toLocaleString('en-GB')}</span>
      </p>
      <p class="cost-result__min">£500 for a bespoke 5-page site. Extras add on top. Not a quote.</p>
      <a href="#contact" class="cost-result__cta">Get an accurate quote <span aria-hidden="true">→</span></a>
    </aside>
  </form>
</section>

<script>
  const form = document.querySelector('.cost-form') as HTMLFormElement | null;
  if (form) {
    const BASE = Number(form.dataset.base);
    const BASE_PAGES = Number(form.dataset.basePages);
    const PER_PAGE = Number(form.dataset.perPage);
    const CUSTOM = Number(form.dataset.custom);
    const FORMS = Number(form.dataset.forms);
    const AI = Number(form.dataset.ai);

    const pagesEl = form.querySelector<HTMLInputElement>('#cost-pages');
    const pagesOut = form.querySelector<HTMLOutputElement>('#cost-pages-out');
    const amountEl = form.querySelector<HTMLSpanElement>('#cost-amount');
    const customEl = form.querySelector<HTMLInputElement>('input[name="customDesign"]');
    const formsEl = form.querySelector<HTMLInputElement>('input[name="formsMailing"]');
    const aiEl = form.querySelector<HTMLInputElement>('input[name="ai"]');

    const recalc = () => {
      const pages = Number(pagesEl?.value ?? BASE_PAGES);
      const extra = Math.max(0, pages - BASE_PAGES);
      const total =
        BASE +
        extra * PER_PAGE +
        (customEl?.checked ? CUSTOM : 0) +
        (formsEl?.checked ? FORMS : 0) +
        (aiEl?.checked ? AI : 0);
      if (pagesOut) pagesOut.textContent = String(pages);
      if (amountEl) amountEl.textContent = total.toLocaleString('en-GB');
    };

    form.addEventListener('input', recalc);
    form.addEventListener('submit', (e) => e.preventDefault());
    recalc();
  }
</script>

<style>
  #cost {
    padding-block: 1rem 1.5rem;
  }

  .cost__heading {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .cost__intro {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .cost-form {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .cost-form {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .cost-controls {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── Range slider ── */
  .cost-control__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .cost-control__label {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .cost-control__value {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .cost-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    outline: none;
    cursor: pointer;
  }

  .cost-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg-surface);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform var(--transition);
  }

  .cost-range::-webkit-slider-thumb:hover,
  .cost-range::-webkit-slider-thumb:active {
    transform: scale(1.1);
  }

  .cost-range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg-surface);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }

  .cost-range:focus-visible {
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .cost-range__scale {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-top: 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  /* ── Toggles ── */
  .cost-toggles {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cost-toggle {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .cost-toggle:hover {
    border-color: var(--border-strong);
  }

  .cost-toggle:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .cost-toggle input {
    /* Visually hidden but keyboard-accessible; the whole label is the hit target */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cost-toggle__body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .cost-toggle__name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }

  .cost-toggle__hint {
    font-size: var(--text-xs);
    color: var(--text-faint);
    line-height: 1.4;
  }

  .cost-toggle__price {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cost-toggle:has(input:checked) .cost-toggle__price {
    color: var(--accent);
  }

  /* ── Result panel ── */
  .cost-result {
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
    position: sticky;
    top: calc(var(--nav-h) + 1rem);
  }

  @media (max-width: 720px) {
    .cost-result {
      position: static;
    }
  }

  .cost-result__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }

  .cost-result__value {
    font-size: clamp(2.5rem, 6vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.75rem;
  }

  .cost-result__min {
    font-size: var(--text-xs);
    color: var(--text-faint);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .cost-result__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 0.65em 1.25em;
    transition: background-color var(--transition);
  }

  .cost-result__cta:hover {
    background: var(--accent-hover);
  }

  .cost-result__cta span {
    transition: transform var(--transition);
  }

  .cost-result__cta:hover span {
    transform: translateX(2px);
  }
</style>
