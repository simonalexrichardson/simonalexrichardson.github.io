---
import { site, serviceAreaText } from '../config/site';

const year = new Date().getFullYear();
const links = [
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{site.name}</p>
      <p>Websites from {site.location.town}, for {serviceAreaText}.</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="site-footer__copy">© {site.name} {year}</p>
    </div>
    <ul class="site-footer__links" role="list">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    --container-max: 1080px;
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
    color: var(--text-muted);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .site-footer__name { color: var(--text); font-weight: 650; }
  .site-footer__copy { margin-top: 0.75rem; font-size: var(--text-sm); }

  .site-footer a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
    transition: color var(--transition);
  }

  .site-footer a:hover { color: var(--accent-text); }

  .site-footer__links { list-style: none; }
</style>
