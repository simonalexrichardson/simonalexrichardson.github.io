---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">© Simon Richardson {year}</p>
    <!-- Email constructed by JS — never in HTML source so scrapers can't grab it -->
    <a href="#contact" id="footer-email" class="site-footer__email">
      Email me directly
    </a>
  </div>
</footer>

<script>
  const el = document.getElementById('footer-email') as HTMLAnchorElement | null;
  if (el) {
    const addr = 'simonalexrichardson' + '@' + 'gmail.com';
    el.href = 'mailto:' + addr;
    el.textContent = addr;
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer__copy {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .site-footer__email {
    font-size: var(--text-sm);
    color: var(--text-faint);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .site-footer__email:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
