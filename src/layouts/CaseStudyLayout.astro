---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  project: string;
  role: string;
  summary: string;
  tags: string[];
  liveUrl?: string;
  image?: string;
  imageAlt?: string;
  publishedAt: Date;
  updatedAt?: Date;
}

const {
  title,
  project,
  role,
  summary,
  tags,
  liveUrl,
  image,
  imageAlt,
  publishedAt,
  updatedAt,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  url: canonicalURL.toString(),
  image: image ? new URL(image, Astro.site).toString() : undefined,
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt ? new Date(updatedAt).toISOString() : new Date(publishedAt).toISOString(),
  author: { '@type': 'Person', '@id': 'https://simonrichardson.dev/#person', name: 'Simon Richardson' },
  publisher: { '@id': 'https://simonrichardson.dev/#person' },
  mainEntityOfPage: canonicalURL.toString(),
  about: project,
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={`${title} — Simon Richardson`}
  description={summary}
  ogImage={image ?? '/images/og-image.png'}
>
  <main id="main" class="case-study">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <article class="container">
      <p class="eyebrow"><a href="/#work" class="case-study__back">← All work</a></p>

      <header class="case-study__header">
        <p class="section-label">{project} · case study</p>
        <h1 class="case-study__heading">{title}</h1>
        <p class="case-study__summary">{summary}</p>

        <dl class="case-study__meta">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{formatDate(publishedAt)}</dd>
          </div>
          {liveUrl && (
            <div>
              <dt>Live</dt>
              <dd>
                <a href={liveUrl} target="_blank" rel="noopener noreferrer">
                  {new URL(liveUrl).hostname} ↗
                </a>
              </dd>
            </div>
          )}
        </dl>
      </header>

      {image && (
        <figure class="case-study__hero">
          <img src={image} alt={imageAlt ?? `Screenshot of ${project}`} width="1280" height="800" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="case-study__body prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <ul class="case-study__tags" role="list">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}

      <div class="case-study__cta">
        <a href="/#contact" class="case-study__btn">Start a project →</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case-study {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .case-study__back {
    color: var(--text-faint);
    transition: color var(--transition);
  }

  .case-study__back:hover {
    color: var(--accent);
  }

  .case-study__header {
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }

  .case-study__heading {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-block: 0.75rem 1rem;
  }

  .case-study__summary {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .case-study__meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 1.5rem 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 540px) {
    .case-study__meta { grid-template-columns: repeat(2, 1fr); }
  }

  .case-study__meta dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.25rem;
  }

  .case-study__meta dd {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .case-study__hero {
    margin-block: 2.5rem 3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .case-study__hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-study__body {
    max-width: 65ch;
  }

  .prose h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-block: 2.5rem 0.875rem;
  }

  .prose h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-block: 1.75rem 0.625rem;
  }

  .prose p {
    font-size: var(--text-base);
    color: var(--text);
    line-height: 1.75;
    margin-bottom: 1.125rem;
  }

  .prose ul, .prose ol {
    padding-left: 1.25rem;
    margin-bottom: 1.125rem;
  }

  .prose li {
    font-size: var(--text-base);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }

  .prose strong { font-weight: 700; }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-subtle);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .prose a:hover { text-decoration-color: var(--accent); }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin-block: 2.5rem;
  }

  .case-study__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-width: 65ch;
    margin-block: 2.5rem;
  }

  .case-study__cta {
    max-width: 65ch;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .case-study__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    padding: 0.65em 1.4em;
    transition: background-color var(--transition);
  }

  .case-study__btn:hover { background: var(--accent); }
</style>
