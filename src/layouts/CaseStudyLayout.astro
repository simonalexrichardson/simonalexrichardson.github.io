---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  project: string;
  role: string;
  summary: string;
  tags: string[];
  liveUrl?: string;
  image?: string;
  imageAlt?: string;
  publishedAt: Date;
  updatedAt?: Date;
  slug: string;
}

const {
  title,
  project,
  role,
  summary,
  tags,
  liveUrl,
  image,
  imageAlt,
  publishedAt,
  updatedAt,
  slug,
} = Astro.props;

const ogImage = `/images/og/${slug}.png`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  url: canonicalURL.toString(),
  image: image ? new URL(image, Astro.site).toString() : undefined,
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt ? new Date(updatedAt).toISOString() : new Date(publishedAt).toISOString(),
  author: { '@type': 'Person', '@id': 'https://simonrichardson.dev/#person', name: 'Simon Richardson' },
  publisher: { '@id': 'https://simonrichardson.dev/#person' },
  mainEntityOfPage: canonicalURL.toString(),
  about: project,
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={`${title} — Simon Richardson`}
  description={summary}
  ogImage={ogImage}
>
  <main id="main" class="case-study">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <article class="container">
      <p class="eyebrow"><a href="/#work" class="case-study__back">← All work</a></p>

      <header class="case-study__header">
        <p class="section-label">{project} · case study</p>
        <h1 class="case-study__heading">{title}</h1>
        <p class="case-study__summary">{summary}</p>

        <dl class="case-study__meta">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{formatDate(publishedAt)}</dd>
          </div>
          {liveUrl && (
            <div>
              <dt>Live</dt>
              <dd>
                <a href={liveUrl} target="_blank" rel="noopener noreferrer">
                  {new URL(liveUrl).hostname} ↗
                </a>
              </dd>
            </div>
          )}
        </dl>
      </header>

      {image && (
        <figure class="case-study__hero">
          <img src={image} alt={imageAlt ?? `Screenshot of ${project}`} width="1280" height="800" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="case-study__body prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <ul class="case-study__tags" role="list">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}

      <div class="case-study__cta">
        <a href="/#contact" class="case-study__btn">Start a project →</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  /* Narrower reading column than the rest of the site (760 vs 960). */
  .case-study .container {
    max-width: 760px;
  }

  .case-study {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  .case-study__back {
    color: var(--text-faint);
    transition: color var(--transition);
  }

  .case-study__back:hover {
    color: var(--accent);
  }

  /* ── Header ───────────────────────────────────────────────── */

  .case-study__header {
    margin-block: 1.25rem 0;
  }

  .case-study__heading {
    font-size: clamp(2rem, 4.5vw, 2.875rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-block: 0.875rem 1.25rem;
    text-wrap: balance;
  }

  .case-study__summary {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 2.25rem;
    max-width: 60ch;
  }

  .case-study__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .case-study__meta dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.375rem;
  }

  .case-study__meta dd {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .case-study__meta a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-subtle);
    text-underline-offset: 3px;
  }

  .case-study__meta a:hover {
    text-decoration-color: var(--accent);
  }

  /* ── Hero image ───────────────────────────────────────────── */

  .case-study__hero {
    margin-block: 3rem 3.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow: var(--shadow-card);
  }

  .case-study__hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Prose body ───────────────────────────────────────────── */

  .case-study__body {
    font-size: 1.0625rem;
    color: var(--text);
  }

  /* Lobotomised-owl flow spacing — every direct child gets top breathing room.
     Higher specificity than .prose p / .prose ul rules below so it wins. */
  .prose > * + *,
  .case-study__body > * + * {
    margin-top: 1.6rem;
  }

  .prose h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-top: 3.5rem !important;
    margin-bottom: 1rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
    text-wrap: balance;
  }

  .prose > h2:first-child {
    margin-top: 0 !important;
    padding-top: 0;
    border-top: none;
  }

  .prose h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-top: 2.25rem !important;
    margin-bottom: 0.5rem;
  }

  /* Tighten heading-to-paragraph gap (overrides the > * + * rule) */
  .prose h2 + p,
  .prose h3 + p {
    margin-top: 0;
  }

  .prose p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    padding-left: 1.5rem;
  }

  .prose li {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: 0.625rem;
  }

  .prose li:last-child { margin-bottom: 0; }

  .prose li::marker {
    color: var(--accent);
  }

  .prose strong { font-weight: 700; color: var(--text); }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 2rem 0 0;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-subtle);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .prose a:hover { text-decoration-color: var(--accent); }

  .prose hr {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 3rem 0 0;
  }

  /* ── Tags + CTA ───────────────────────────────────────────── */

  .case-study__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2.5rem;
  }

  .case-study__cta {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .case-study__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    padding: 0.65em 1.4em;
    transition: background-color var(--transition), transform var(--transition);
  }

  .case-study__btn:hover { background: var(--accent); }
  .case-study__btn:active { transform: scale(0.97); }
</style>
