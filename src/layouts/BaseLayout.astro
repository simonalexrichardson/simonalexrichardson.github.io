---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Simon Richardson · Freelance web designer & developer (UK)',
  description = 'Simon Richardson is a UK-based freelance web developer. I build marketing sites, custom web apps, and AI features for clients who want them to actually work.',
  ogImage = '/images/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const SITE_URL = 'https://simonrichardson.dev/';
const PERSON_ID = `${SITE_URL}#person`;
const WEBSITE_ID = `${SITE_URL}#website`;
const BUSINESS_ID = `${SITE_URL}#business`;

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Simon Richardson',
      url: SITE_URL,
      jobTitle: 'Freelance web designer & developer',
      description: 'UK-based freelance developer building marketing sites, custom web apps, and AI features.',
      image: ogImageURL.toString(),
      address: { '@type': 'PostalAddress', addressCountry: 'GB' },
      sameAs: ['https://github.com/simonalexrichardson'],
      worksFor: { '@id': BUSINESS_ID },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: 'Simon Richardson',
      url: SITE_URL,
      publisher: { '@id': PERSON_ID },
      inLanguage: 'en-GB',
    },
    {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: 'Simon Richardson · Web design & development',
      url: SITE_URL,
      image: ogImageURL.toString(),
      description: 'Freelance web design and development from the UK: marketing sites, custom web apps, AI features.',
      areaServed: { '@type': 'Country', name: 'United Kingdom' },
      provider: { '@id': PERSON_ID },
      priceRange: '££',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Marketing site design & build', description: 'Landing pages and multi-page sites that load fast and convert.' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom web applications', description: 'Forms, dashboards, payments, auth. Bespoke web apps.' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI features and integrations', description: 'Claude API, email automation, AI-powered workflows.' } },
        ],
      },
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6e1423" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS feed for /writing -->
    <link rel="alternate" type="application/rss+xml" title="Simon Richardson · Writing" href="/writing/rss.xml" />

    <!-- IndieWeb verification (Mastodon, Bridgy etc. read rel=me) -->
    <link rel="me" href="https://github.com/simonalexrichardson" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Simon Richardson" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Simon Richardson · freelance web designer & developer (UK)" />
    <meta property="og:site_name" content="Simon Richardson" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Simon Richardson · freelance web designer & developer (UK)" />

    <!-- Indexing: allowed -->
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Search engine verification -->
    <meta name="google-site-verification" content="TSrW0pwokdxbeA5lXZ58PN4xG87p4t7NIZuZDp7zmpY" />

    <!-- Structured data: Person + WebSite + ProfessionalService graph -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(seoJsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only sr-only-focusable">Skip to main content</a>
    <Nav />
    <slot />
  </body>
</html>
