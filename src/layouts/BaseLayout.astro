---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';

// Critical font URLs for preload (Vite resolves to hashed asset paths at build)
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import frauncesLatinItalic from '@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2?url';
import caveatLatin from '@fontsource/caveat/files/caveat-latin-400-normal.woff2?url';
import Nav from '../components/Nav.astro';
import BackToTop from '../components/BackToTop.astro';
import { site, serviceAreaText } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Websites for small businesses in Hitchin, Herts & Cambs · Simon Richardson',
  description = `Bespoke websites for small businesses, trades, bands and clubs in ${serviceAreaText}, built and looked after by one person you can actually talk to.`,
  ogImage = '/images/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const SITE_URL = 'https://simonrichardson.dev/';
const PERSON_ID = `${SITE_URL}#person`;
const WEBSITE_ID = `${SITE_URL}#website`;
const BUSINESS_ID = `${SITE_URL}#business`;

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: site.name,
      url: SITE_URL,
      jobTitle: 'Web designer',
      image: ogImageURL.toString(),
      address: { '@type': 'PostalAddress', addressLocality: site.location.town, addressRegion: site.location.county, addressCountry: site.location.country },
      sameAs: ['https://github.com/simonalexrichardson'],
      worksFor: { '@id': BUSINESS_ID },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: site.name,
      url: SITE_URL,
      publisher: { '@id': PERSON_ID },
      inLanguage: 'en-GB',
    },
    {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: `${site.name} Web Design`,
      url: SITE_URL,
      image: ogImageURL.toString(),
      email: site.email,
      ...(site.phone ? { telephone: site.phone } : {}),
      description: `Bespoke websites for small businesses in ${serviceAreaText}, built and looked after by one person.`,
      address: { '@type': 'PostalAddress', addressLocality: site.location.town, addressRegion: site.location.county, addressCountry: site.location.country },
      areaServed: site.serviceArea.map((name) => ({ '@type': 'AdministrativeArea', name })),
      founder: { '@id': PERSON_ID },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [site.pricing.build, site.pricing.care].map((p) => ({
          '@type': 'Offer',
          priceCurrency: 'GBP',
          price: p.amount,
          itemOffered: { '@type': 'Service', name: p.name, description: p.summary },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6e1423" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload critical fonts so the hero/headings don't pop in -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    {Astro.url.pathname === '/' && <link rel="preload" href={frauncesLatinItalic} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={caveatLatin} as="font" type="font/woff2" crossorigin />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS feed for /writing -->
    <link rel="alternate" type="application/rss+xml" title="Simon Richardson · Writing" href="/writing/rss.xml" />

    <!-- IndieWeb verification (Mastodon, Bridgy etc. read rel=me) -->
    <link rel="me" href="https://github.com/simonalexrichardson" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Simon Richardson" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Your website should be bringing you work. Simon Richardson, web design in Hitchin." />
    <meta property="og:site_name" content="Simon Richardson" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Your website should be bringing you work. Simon Richardson, web design in Hitchin." />

    <!-- Indexing: allowed -->
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Search engine verification -->
    <meta name="google-site-verification" content="TSrW0pwokdxbeA5lXZ58PN4xG87p4t7NIZuZDp7zmpY" />

    {site.cloudflareAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}></script>
    )}

    <!-- Structured data: Person + WebSite + ProfessionalService graph -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(seoJsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only sr-only-focusable">Skip to main content</a>
    <Nav />
    <slot />
    <BackToTop />
  </body>
</html>
