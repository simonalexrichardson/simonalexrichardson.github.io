---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  summary: string;
  tags: string[];
  publishedAt: Date;
  updatedAt?: Date;
  slug: string;
  readingMinutes: number;
}

const { title, summary, tags, publishedAt, updatedAt, slug, readingMinutes } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  url: canonicalURL.toString(),
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt ? new Date(updatedAt).toISOString() : new Date(publishedAt).toISOString(),
  author: { '@type': 'Person', '@id': 'https://simonrichardson.dev/#person', name: 'Simon Richardson' },
  publisher: { '@id': 'https://simonrichardson.dev/#person' },
  mainEntityOfPage: canonicalURL.toString(),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={`${title} · Simon Richardson`}
  description={summary}
>
  <main id="main" class="writing">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <article class="container">
      <p class="eyebrow"><a href="/writing" class="writing__back">← Writing</a></p>

      <header class="writing__header">
        <h1 class="writing__heading">{title}</h1>
        <p class="writing__summary">{summary}</p>
        <p class="writing__date">
          <time datetime={new Date(publishedAt).toISOString()}>{fmtDate(publishedAt)}</time>
          <span aria-hidden="true"> · </span>
          <span>{readingMinutes} min read</span>
          {updatedAt && (
            <>
              <span aria-hidden="true"> · </span>
              <span>Updated {fmtDate(updatedAt)}</span>
            </>
          )}
        </p>
      </header>

      <div class="writing__body prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <ul class="writing__tags" role="list">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}

      <div class="writing__cta">
        <a href="/#contact" class="writing__btn">Start a project →</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .writing .container { max-width: 720px; }

  .writing {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  .writing__back { color: var(--text-faint); transition: color var(--transition); }
  .writing__back:hover { color: var(--accent); }

  .writing__header { margin-block: 1.25rem 2.5rem; }

  .writing__heading {
    font-size: clamp(2rem, 4.5vw, 2.875rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-block: 0.875rem 1rem;
    text-wrap: balance;
  }

  .writing__summary {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .writing__date {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .writing__body {
    font-size: 1.0625rem;
    color: var(--text);
  }

  .writing__body > * + * { margin-top: 1.6rem; }

  .writing__body h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-top: 3.25rem !important;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .writing__body h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 2.25rem !important;
    margin-bottom: 0.5rem;
  }

  .writing__body h2 + p,
  .writing__body h3 + p { margin-top: 0; }

  .writing__body p { line-height: 1.75; }

  .writing__body ul, .writing__body ol {
    padding-left: 1.5rem;
    list-style: disc;
  }

  .writing__body li {
    line-height: 1.75;
    margin-bottom: 0.625rem;
  }

  .writing__body li::marker { color: var(--accent); }

  .writing__body strong { font-weight: 700; color: var(--text); }

  .writing__body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-subtle);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .writing__body a:hover { text-decoration-color: var(--accent); }

  .writing__body code {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.9em;
    background: var(--bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .writing__body pre {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.9em;
    line-height: 1.6;
  }

  .writing__body pre code {
    background: transparent;
    padding: 0;
    border: none;
    font-size: inherit;
  }

  .writing__body blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 2rem 0 0;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .writing__body hr {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 3rem 0 0;
  }

  .writing__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2.5rem;
  }

  .writing__cta {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .writing__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    padding: 0.65em 1.4em;
    transition: background-color var(--transition), transform var(--transition);
  }

  .writing__btn:hover { background: var(--accent); }
  .writing__btn:active { transform: scale(0.97); }
</style>
