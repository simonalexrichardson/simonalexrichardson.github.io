---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection(
  'writing',
  ({ data }) => import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt));

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Writing · Simon Richardson"
  description="Notes, posts, and longer pieces by Simon Richardson, UK-based freelance web developer."
>
  <main id="main" class="writing-index">
    <article class="container">
      <p class="eyebrow"><a href="/" class="writing-index__back">← Home</a></p>

      <header class="writing-index__header">
        <p class="section-label">Writing</p>
        <h1 class="writing-index__heading">Notes, posts, longer pieces</h1>
        <p class="writing-index__intro">
          Occasional writing on what I'm building, decisions I've made and broken,
          and tools I've leaned on.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="writing-index__empty">Nothing published yet. Check back soon.</p>
      ) : (
        <ul class="writing-index__list" role="list">
          {posts.map((post) => (
            <li class="writing-index__item">
              <a href={`/writing/${post.id}`} class="writing-index__link">
                <p class="writing-index__date">
                  <time datetime={new Date(post.data.publishedAt).toISOString()}>
                    {fmtDate(post.data.publishedAt)}
                  </time>
                </p>
                <h2 class="writing-index__title">{post.data.title}</h2>
                <p class="writing-index__summary">{post.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .writing-index .container { max-width: 720px; }

  .writing-index {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  .writing-index__back {
    color: var(--text-faint);
    transition: color var(--transition);
  }

  .writing-index__back:hover { color: var(--accent); }

  .writing-index__header {
    margin-block: 1.25rem 3rem;
  }

  .writing-index__heading {
    font-size: clamp(2rem, 4.5vw, 2.875rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-block: 0.875rem 1.25rem;
    text-wrap: balance;
  }

  .writing-index__intro {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 60ch;
  }

  .writing-index__empty {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.7;
    padding: 2rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .writing-index__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .writing-index__item {
    border-top: 1px solid var(--border);
  }

  .writing-index__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .writing-index__link {
    display: block;
    padding-block: 1.5rem;
    transition: background-color var(--transition);
  }

  .writing-index__link:hover {
    background: color-mix(in srgb, var(--bg-subtle) 60%, transparent);
  }

  .writing-index__link:hover .writing-index__title {
    color: var(--accent);
  }

  .writing-index__date {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .writing-index__title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color var(--transition);
  }

  .writing-index__summary {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
